generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  type        String
  result      String
  imagePath   String?
  className   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model AdminTotpState {
  id       String @id
  lastStep BigInt
}

model ContactSubmission {
  id             String   @id @default(cuid())
  name           String
  email          String
  message        String
  emailSent      Boolean  @default(false)
  status         String   @default("new")
  idempotencyKey String?  @unique
  payloadHash    String?
  notificationStatus      String   @default("pending")
  notificationAttempts    Int      @default(0)
  notificationLeaseUntil  DateTime?
  notificationNextAttempt DateTime?
  webhookStatus           String   @default("pending")
  webhookAttempts         Int      @default(0)
  webhookLeaseUntil       DateTime?
  webhookNextAttempt      DateTime?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([notificationStatus, notificationNextAttempt])
  @@index([webhookStatus, webhookNextAttempt])
}

