# Database (PostgreSQL via Neon)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Resend Email Integration
RESEND_API_KEY="re_123456789"
CONTACT_EMAIL_TO="user@example.com"
RESEND_FROM_EMAIL="onboarding@resend.dev"
CRON_SECRET="unique-random-secret-for-vercel-cron"

# Optional distributed rate limiting. Without both variables, limits are per process.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Configure only if your reverse proxy overwrites this header before forwarding.
# On Vercel, the app uses x-vercel-forwarded-for automatically.
TRUSTED_PROXY_IP_HEADER=""

# Admin Authentication
# Production requires a bcrypt hash. Plaintext is accepted only outside production.
ADMIN_PASSWORD="bcrypt-hash-generated-for-your-admin-password"
# Use a unique random value of at least 32 characters; never reuse ADMIN_PASSWORD.
ADMIN_SESSION_SECRET="generate-a-unique-random-session-secret-at-least-32-chars"
# Required for production admin login. Generate a random Base32 secret, enroll
# it in an authenticator, then store the exact secret only in server env.
ADMIN_TOTP_SECRET=""

# Optional signed lead webhook. Both values are required to enable new leads.
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_SECRET=""
NOTIFICATION_WEBHOOK_KIND="generic" # generic, slack, or discord

# S3 or S3-compatible project media storage. AWS may use its default credential
# chain; a custom endpoint such as R2 requires the two explicit credentials.
PROJECT_MEDIA_BUCKET=""
PROJECT_MEDIA_REGION="us-east-1"
PROJECT_MEDIA_ENDPOINT=""
PROJECT_MEDIA_ACCESS_KEY_ID=""
PROJECT_MEDIA_SECRET_ACCESS_KEY=""

# A ClamAV daemon is required for uploads in production. Prefer a private Unix
# socket. If using TCP, expose it only on a private network.
CLAMAV_SOCKET_PATH=""
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Public Business Contact (Used in CTA links & footer)
NEXT_PUBLIC_WHATSAPP_NUMBER="628xxxxxxxxxx"
NEXT_PUBLIC_CONTACT_EMAIL="contact@yourbusiness.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_INSTAGRAM_URL=""

# Set only after a retention policy is approved; used by the explicit purge script.
CONTACT_RETENTION_DAYS=""
